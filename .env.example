LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_DEFAULT_MODEL=google/gemma-3-4b
LOCAL_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
# Quando true, expõe somente o frontend na rede privada, pela porta 4200.
LAN_ACCESS=false
DJANGO_SECRET_KEY=change-this-only-for-a-non-development-install
DJANGO_DEBUG=true
# Credenciais internas ficam em data/auth/users.csv (fora do Git).
